{
  "name": "agent-platform",
  "private": false,
  "license": "MIT",
  "scripts": {
    "prepare": "test -d .git && lefthook install && git config commit.template .gitmessage || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "typecheck:affected": "turbo run typecheck --affected",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "test:watch": "turbo run test:watch",
    "test:e2e": "pnpm --filter @seta/web test:e2e",
    "lint": "pnpm depcruise && pnpm lint:styles && pnpm lint:raw-sql && pnpm lint:db && pnpm lint:test-layout && pnpm lint:module-shape && pnpm lint:rbac-coverage && pnpm exec biome ci . && pnpm lint:db-drift",
    "lint:db": "node scripts/lint/lint-db.mjs && node scripts/lint/lint-migration-prefixes.mjs && node scripts/lint/lint-mastra-access.mjs",
    "lint:db-drift": "node scripts/lint/check-db-drift.mjs",
    "lint:module-shape": "node scripts/lint/lint-module-shape.mjs",
    "lint:rbac-coverage": "node scripts/lint/lint-rbac-coverage.mjs",
    "lint:raw-sql": "bash scripts/lint/audit-raw-sql.sh",
    "lint:styles": "bash packages/shared-config/scripts/grep-no-stray-styles.sh",
    "lint:test-layout": "node scripts/lint/lint-test-layout.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "depcruise": "depcruise apps packages sdks --config .dependency-cruiser.cjs",
    "gen": "turbo gen run",
    "gen:rbac": "pnpm exec tsx scripts/gen-rbac.ts",
    "db:up": "docker compose --profile bundled-db up -d postgres minio minio-setup",
    "db:down": "docker compose --profile bundled-db down",
    "db:migrate": "pnpm -F @seta/cli exec tsx src/index.ts migrate",
    "db:seed": "pnpm -F @seta/cli exec tsx src/index.ts seed",
    "db:reset": "docker compose --profile bundled-db down -v && pnpm db:up && sleep 3 && pnpm db:migrate && pnpm db:seed",
    "eval:quality": "pnpm -F @seta/cli exec tsx src/index.ts eval-quality --trigger manual",
    "smoke:login": "tsx apps/web/e2e/login.smoke.ts",
    "docker:build:server": "docker build -f infra/docker/server.Dockerfile -t seta-server:local .",
    "docker:build:web": "docker build -f infra/docker/web.Dockerfile -t seta-web:local .",
    "docker:build": "pnpm docker:build:server && pnpm docker:build:web",
    "release:check": "bash scripts/release/release-check.sh --no-build",
    "release:check:full": "bash scripts/release/release-check.sh",
    "gen:dashboards": "pnpm -F @seta/grafana-dashboards run gen",
    "seed:golden": "tsx scripts/dev/seed-golden-dataset.ts",
    "seed:golden:login": "tsx scripts/dev/seed-golden-dataset-login.ts",
    "seed:golden:embed": "tsx scripts/dev/seed-golden-dataset-embed.ts",
    "golden:facts:generate": "tsx scripts/dev/golden-facts.ts generate",
    "golden:facts:diff": "tsx scripts/dev/golden-facts.ts diff",
    "golden:facts:promote": "tsx scripts/dev/golden-facts.ts promote"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.3.0",
    "@biomejs/biome": "^2.5.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@seta/shared-config": "workspace:^",
    "@turbo/gen": "^2.10.6",
    "dependency-cruiser": "^18.1.0",
    "jiti": "^2.7.0",
    "lefthook": "^2.1.10",
    "tsx": "^4.23.1",
    "turbo": "^2.10.6",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=24"
  }
}
