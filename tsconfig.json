{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["apps/**/*", "packages/**/*", "sdks/**/*"],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/build/**", "**/.turbo/**"]
}
