{
  "autoCompactWindow": 200000,
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}/.claude/statusline.sh\""
  },
  "permissions": {
    "deny": ["Workflow"]
  },
  "env": {
    "ECC_GATEGUARD": "off"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true
  }
}
