{
  "name": "@seta/planner",
  "version": "0.0.1",
  "private": true,
  "description": "Planner module — plans, buckets, groups, and tasks with kanban/grid/sheet projections. Two-way Microsoft Planner sync.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agent-tools": "./src/agent-tools.ts",
    "./orchestration": "./src/orchestration.ts",
    "./rbac": "./src/rbac.ts",
    "./register": "./src/register.ts",
    "./agent-tools/register": {
      "types": "./src/backend/agent-tools/register.ts",
      "default": "./src/backend/agent-tools/register.ts"
    },
    "./events": "./src/events/index.ts",
    "./evals": "./src/backend/orchestration/eval-manifest.ts",
    "./http": "./src/backend/http/index.ts",
    "./stream": "./src/backend/stream/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "devDependencies": {
    "@seta/core": "workspace:^",
    "@seta/shared-config": "workspace:^",
    "@seta/shared-db": "workspace:^",
    "@seta/shared-rbac": "workspace:^",
    "@seta/shared-testing": "workspace:^",
    "@seta/shared-types": "workspace:^",
    "@types/node": "26.1.1",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.1",
    "ai": "^7.0.35",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@mastra/core": "^1.57.0",
    "@mastra/observability": "^1.16.5",
    "@mastra/pg": "^1.19.0",
    "@mastra/rag": "^2.4.2",
    "@opentelemetry/api": "^1.9.1",
    "@seta/agent-sdk": "workspace:^",
    "@seta/identity": "workspace:^",
    "@seta/notifications": "workspace:^",
    "@seta/people": "workspace:^",
    "@seta/shared-agent-evals": "workspace:*",
    "@seta/shared-embeddings": "workspace:^",
    "@seta/shared-orchestration": "workspace:*",
    "@seta/shared-retrieval": "workspace:^",
    "drizzle-orm": "^0.45.2",
    "fractional-indexing": "^4.0.0",
    "graphile-worker": "^0.17.3",
    "hono": "^4.12.34",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "sanitize-html": "^2.17.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
