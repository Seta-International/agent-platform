{
  "name": "@seta/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Seta API server — Hono HTTP entry point, dispatcher, and graphile-worker host. Composes every domain module.",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mastra/core": "^1.52.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-prometheus": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@seta/agent": "workspace:^",
    "@seta/agent-sdk": "workspace:^",
    "@seta/core": "workspace:^",
    "@seta/hiring": "workspace:^",
    "@seta/identity": "workspace:^",
    "@seta/integrations": "workspace:^",
    "@seta/knowledge": "workspace:^",
    "@seta/notifications": "workspace:^",
    "@seta/people": "workspace:^",
    "@seta/planner": "workspace:^",
    "@seta/pm": "workspace:^",
    "@seta/shared-crypto": "workspace:^",
    "@seta/shared-db": "workspace:^",
    "@seta/shared-embeddings": "workspace:^",
    "@seta/shared-mailer": "workspace:^",
    "@seta/shared-orchestration": "workspace:*",
    "@seta/shared-rbac": "workspace:^",
    "@seta/shared-types": "workspace:^",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31",
    "pino": "^10.3.1",
    "tsx": "^4.23.1",
    "undici": "^8.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.12",
    "@seta/shared-agent-evals": "workspace:*",
    "@seta/shared-config": "workspace:^",
    "@seta/shared-testing": "workspace:^",
    "@types/node": "26.1.1",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  }
}
