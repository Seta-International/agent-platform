{
  "name": "@seta/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Seta web client — React 19, TanStack Router, AI SDK v6, and assistant-ui. The single-page front end for the platform.",
  "scripts": {
    "dev": "vite",
    "generate-routes": "tsr generate",
    "build": "pnpm generate-routes && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "size": "size-limit",
    "test": "NODE_OPTIONS='--no-experimental-webstorage' vitest run",
    "test:watch": "NODE_OPTIONS='--no-experimental-webstorage' vitest",
    "test:e2e": "playwright test",
    "typecheck": "pnpm generate-routes && tsc -b --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.38",
    "@assistant-ui/react-markdown": "^0.14.6",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@hello-pangea/dnd": "^18.0.1",
    "@mastra/ai-sdk": "^1.6.3",
    "@seta/module-sdk": "workspace:^",
    "@seta/planner": "workspace:^",
    "@seta/shared-rbac": "workspace:^",
    "@seta/shared-ui": "workspace:^",
    "@seta/web-admin": "workspace:*",
    "@seta/web-agent": "workspace:*",
    "@seta/web-hiring": "workspace:*",
    "@seta/web-identity": "workspace:*",
    "@seta/web-notifications": "workspace:*",
    "@seta/web-people": "workspace:*",
    "@seta/web-planner": "workspace:*",
    "@seta/web-pm": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-virtual": "^3.14.8",
    "@tanstack/router-plugin": "^1.168.23",
    "better-auth": "^1.6.25",
    "date-fns": "^4.4.0",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "web-vitals": "^6.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
