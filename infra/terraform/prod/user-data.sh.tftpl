#!/usr/bin/env bash
# UNATTENDED RECOVERY: a fresh ASG instance self-restores to a running app with
# NO human — installs docker, brings up the cloudflared tunnel as a service, and
# registers the GitHub Actions runner as a service. Boot secrets come from SSM
# SecureString (instance-role read). App is then restored by the recovery deploy.
set -euxo pipefail

dnf update -y
dnf install -y docker jq
systemctl enable --now docker

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

REGION="${region}"

# ── Cloudflare tunnel as a systemd service (token from SSM) ──────────────────
curl -fsSL "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.rpm" \
  -o /tmp/cloudflared.rpm && dnf install -y /tmp/cloudflared.rpm
CF_TOKEN=$(aws ssm get-parameter --region "$REGION" --name /seta/prod/cloudflared-token --with-decryption --query Parameter.Value --output text)
cloudflared service install "$CF_TOKEN"   # installs + enables the tunnel service

# ── GitHub Actions runner as a service (JIT registration token via a boot PAT) ─
RUNNER_USER=ec2-user
GITHUB_RUNNER_URL="${github_runner_url}"
GH_PAT=$(aws ssm get-parameter --region "$REGION" --name /seta/prod/gh-runner-registration --with-decryption --query Parameter.Value --output text)
REPO="$${GITHUB_RUNNER_URL##*/github.com/}"    # e.g. org/agent-platform
REG_TOKEN=$(curl -fsSL -X POST -H "Authorization: Bearer $GH_PAT" \
  -H "Accept: application/vnd.github+json" \
  "https://api.github.com/repos/$REPO/actions/runners/registration-token" | jq -r .token)
mkdir -p /opt/actions-runner && cd /opt/actions-runner
curl -fsSL https://github.com/actions/runner/releases/latest/download/actions-runner-linux-x64.tar.gz | tar xz
chown -R "$RUNNER_USER" /opt/actions-runner
sudo -u "$RUNNER_USER" ./config.sh --unattended --url "$GITHUB_RUNNER_URL" --token "$REG_TOKEN" \
  --labels prod --name "prod-$(hostname)" --replace --ephemeral
./svc.sh install "$RUNNER_USER" && ./svc.sh start
