# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# image_uri: <account-id>.dkr.ecr.<region>.amazonaws.com/future-app:<tag>
db_master_password           = "CHANGE_ME_same_as_github_DATABASE_PASSWORD"
better_auth_secret           = "CHANGE_ME_min_32"
crypto_local_master_key      = "CHANGE_ME_64_hex"
openai_api_key               = "sk-...(real key; required at boot)"
image_uri                    = "ACCOUNT_ID.dkr.ecr.ap-southeast-1.amazonaws.com/future-app:latest"
cloudflared_token_secret_arn = "arn:aws:secretsmanager:ap-southeast-1:ACCOUNT_ID:secret:cloudflared-token-XXXX"
monitoring_username          = "prod-alloy-XXXXXXXX (same as GH prod env var REMOTE_WRITE_USERNAME)"
monitoring_password          = "CHANGE_ME_same_as_github_REMOTE_WRITE_PASSWORD"
