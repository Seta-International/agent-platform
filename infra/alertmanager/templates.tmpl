{{/* MS Teams card for msteamsv2. Because group_by is [env, alertname], every alert
      in a card already shares its status, alertname, env and severity — so the title
      carries those once and the body repeats none of them, listing only what differs
      per alert. Severity appears twice over, as a colour dot and as the word, so the
      card still reads on clients that render no emoji. Times render in the container
      timezone (TZ=Asia/Ho_Chi_Minh -> UTC+7) via .Local. */}}

{{ define "teams.title" -}}
{{ if eq .Status "resolved" }}🟢{{ else if eq .CommonLabels.severity "critical" }}🔴{{ else if eq .CommonLabels.severity "warning" }}🟡{{ else }}⚪{{ end }} [{{ .Status | toUpper }}{{ if eq .Status "firing" }} {{ .Alerts.Firing | len }}{{ end }}{{ with .CommonLabels.severity }} · {{ . | toUpper }}{{ end }}] {{ .CommonLabels.alertname }}{{ with .CommonLabels.env }} · {{ . }}{{ end }}
{{- end }}

{{ define "teams.text" -}}
{{ range .Alerts -}}
**{{ .Annotations.summary }}**

{{ .Annotations.description }}

{{ with .Labels.instance }}{{ . }} · {{ end }}since {{ .StartsAt.Local.Format "2006-01-02 15:04:05 -07:00" }}{{ if and (eq $.Status "resolved") (not .EndsAt.IsZero) }}, resolved {{ .EndsAt.Local.Format "15:04:05" }}{{ end }}

{{ end -}}
[dashboards](https://grafana-future.seta-international.com/dashboards)
{{- end }}
