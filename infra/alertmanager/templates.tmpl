{{/* Plain machine-readable MS Teams card for msteamsv2. Times render in the
      container timezone (TZ=Asia/Ho_Chi_Minh -> UTC+7) via .Local. */}}

{{ define "teams.title" -}}
[{{ .Status | toUpper }}{{ if eq .Status "firing" }} {{ .Alerts.Firing | len }}{{ end }}] {{ .CommonLabels.alertname }}{{ with .CommonLabels.env }} · {{ . }}{{ end }}
{{- end }}

{{ define "teams.text" -}}
{{ range .Alerts -}}
alert: {{ .Labels.alertname }}
status: {{ $.Status }}
severity: {{ .Labels.severity }}
env: {{ .Labels.env }}
{{ with .Labels.instance }}instance: {{ . }}
{{ end }}summary: {{ .Annotations.summary }}
description: {{ .Annotations.description }}
started: {{ .StartsAt.Local.Format "2006-01-02 15:04:05 -07:00" }}
{{ if and (eq $.Status "resolved") (not .EndsAt.IsZero) }}resolved: {{ .EndsAt.Local.Format "2006-01-02 15:04:05 -07:00" }}
{{ end }}
{{ end -}}
dashboards: https://grafana-future.seta-international.com/dashboards
{{- end }}
