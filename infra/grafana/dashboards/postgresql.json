      "targets": [
        {
          "expr": "sum(pg_stat_database_blks_hit{env=~\"$env\"}) / (sum(pg_stat_database_blks_hit{env=~\"$env\"}) + sum(pg_stat_database_blks_read{env=~\"$env\"})) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
