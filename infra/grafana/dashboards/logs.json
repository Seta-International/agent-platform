{
  "uid": "logs",
  "title": "Logs",
  "tags": ["seta", "logs"],
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "query",
        "label": "env",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "env", "type": 1 },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "container",
        "type": "query",
        "label": "container",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "container", "stream": "{env=~\"$env\"}", "type": 1 },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Error log rate (by container)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "logs" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (container) (rate({env=~\"$env\", container=~\"$container\"} |~ \"(?i)level=error|\\\"level\\\":\\\"error\\\"\" [5m]))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 8 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{env=~\"$env\", container=~\"$container\"}"
        }
      ]
    }
  ]
}
