// Metrics: scrape app :9464 + host/DB exporters → remote_write to central.
prometheus.scrape "app" {
  targets = [
    { __address__ = "server:9464" },
    { __address__ = "worker:9464" },
    { __address__ = "node-exporter:9100" },      // host cpu/mem/DISK
    { __address__ = "postgres-exporter:9187" },  // DB connections/size/query stats
  ]
  metrics_path = "/metrics"
  forward_to   = [prometheus.remote_write.central.receiver]
}

// RDS metrics, prod-only (CloudWatch is monitored for prod alone). dev/uat leave
// CLOUDWATCH_TARGET empty; the relabel drops the empty-address target so nothing is
// scraped. (Alloy has no ternary — drop-on-empty is the conditional-target pattern.)
discovery.relabel "rds" {
  targets = [{ __address__ = sys.env("CLOUDWATCH_TARGET") }]
  rule {
    source_labels = ["__address__"]
    regex         = ""
    action        = "drop"
  }
}
prometheus.scrape "rds" {
  targets      = discovery.relabel.rds.output
  metrics_path = "/metrics"
  forward_to   = [prometheus.remote_write.central.receiver]
}

// GPU metrics from the shared inference box (future). Distinct env label so GPU
// series never mix into app-env dashboards/alerts. Set DCGM_TARGET only on the dev
// agent (co-located with the box); empty elsewhere (drop-on-empty as above).
discovery.relabel "gpu" {
  targets = [{ __address__ = sys.env("DCGM_TARGET"), env = "infra-future" }]
  rule {
    source_labels = ["__address__"]
    regex         = ""
    action        = "drop"
  }
}
prometheus.scrape "gpu" {
  targets      = discovery.relabel.gpu.output
  metrics_path = "/metrics"
  forward_to   = [prometheus.remote_write.central.receiver]
}

// Per-container cpu/mem/disk-io/network, prod-only (cadvisor runs only there,
// see compose.prod.yaml). dev/uat leave CADVISOR_TARGET empty (drop-on-empty).
discovery.relabel "cadvisor" {
  targets = [{ __address__ = sys.env("CADVISOR_TARGET") }]
  rule {
    source_labels = ["__address__"]
    regex         = ""
    action        = "drop"
  }
}
prometheus.scrape "cadvisor" {
  targets      = discovery.relabel.cadvisor.output
  metrics_path = "/metrics"
  // 15s matches cadvisor's --housekeeping_interval, so a ~1m rate window (via the
  // board's per-query Min step) stays robust — 4 samples, no gaps — and surfaces
  // ~30s CPU/IO bursts instead of averaging them away. Only this block; app/rds/gpu
  // stay on the 60s default.
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.central.receiver]
}

prometheus.remote_write "central" {
  external_labels = { env = sys.env("MONITORING_ENV") }
  endpoint {
    url = sys.env("REMOTE_WRITE_URL")
    basic_auth {
      username = sys.env("REMOTE_WRITE_USERNAME")
      password = sys.env("REMOTE_WRITE_PASSWORD")
    }
  }
}

// Logs: discover local containers, label by name, push NDJSON stdout → Loki.
discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.local.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }
}

loki.source.docker "app" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  external_labels = { env = sys.env("MONITORING_ENV") }
  endpoint {
    url = sys.env("LOKI_URL")
    basic_auth {
      username = sys.env("REMOTE_WRITE_USERNAME")
      password = sys.env("REMOTE_WRITE_PASSWORD")
    }
  }
}
